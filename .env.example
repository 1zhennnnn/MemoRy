# MemoRy — 環境變數範本
# 複製此檔為 .env，填入實際值後啟動專案
# 注意：.env 已在 .gitignore 中，請勿提交真實金鑰

# ─────────────────────────────────────────────
# 資料庫（必填）
# ─────────────────────────────────────────────

# PostgreSQL 連線字串（含 pgvector）
# Replit 環境：由 Replit Database 自動注入，通常已存在
# 本地開發：postgresql://user:password@localhost:5432/memory
DATABASE_URL=postgresql://user:password@localhost:5432/memory

# ─────────────────────────────────────────────
# Supabase 驗證（必填）
# ─────────────────────────────────────────────

# Supabase JWT Secret（HS256 簽署金鑰）
# 取得方式：Supabase Dashboard → Project Settings → API → JWT Secret
# 注意：這是 "JWT Secret"，不是 "anon key" 或 "service_role key"
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Project URL
# 取得方式：Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key（前端用，非敏感）
# 取得方式：Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────
# Google AI Studio — Gemini API（必填）
# ─────────────────────────────────────────────

# Google AI Studio API Key
# 取得方式：https://aistudio.google.com → Get API key → Create API key
GEMINI_API_KEY=AIzaSy-your-google-ai-studio-key-here

# Gemini 文字生成端點（有預設值，可不填）
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Gemini Embedding 端點（有預設值，可不填）
GEMINI_EMBED_URL=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent

# ─────────────────────────────────────────────
# Server 設定（選填）
# ─────────────────────────────────────────────

# API Server 監聽 port
# Replit 環境：由 workflow 注入，通常為 5000（對外映射為 80）
# 本地開發：5000
PORT=5000

# Express session secret（任意隨機字串即可）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string-in-production

# Node 環境
NODE_ENV=development

# ─────────────────────────────────────────────
# Chrome Extension（前端 .env，選填）
# ─────────────────────────────────────────────

# Extension 連接的 API Base URL
# 本地開發：http://localhost:5000
# 生產環境：https://your-replit-url.replit.app
VITE_API_BASE_URL=http://localhost:5000

# Supabase URL（前端用，同上）
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key（前端用，同上）
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────
# Web Dashboard（前端 .env，選填）
# ─────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────
# 開發模式說明
# ─────────────────────────────────────────────
#
# 1. 沒有 SUPABASE_JWT_SECRET 時：
#    auth middleware 自動切換 parse-only 模式
#    → JWT 不驗簽章，只解析 payload（開發用，生產環境禁止）
#
# 2. 沒有 GEMINI_API_KEY 時：
#    AI 函式回傳 AppError(AI_ERROR)
#    → 筆記仍正常建立，aiStatus = "failed"
#    → 系統不會崩潰（AI 降級設計）
#
# 3. pgvector 啟用確認：
#    連線 PostgreSQL 後執行：CREATE EXTENSION IF NOT EXISTS vector;
#    或：pnpm --filter @workspace/db run push（自動處理）
